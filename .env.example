# Copy to .env and fill in. Never commit .env.

# --- TigerGraph Savanna workspace ---
# Workspace URL from the Savanna portal ("Connect from API"), e.g. https://tg-xxxx.tg-yyyy.i.tgcloud.io
TG_HOST=
TG_GRAPHNAME=RedThread
# Database user created in Savanna (Workspace > Access Management > Database Access)
TG_USERNAME=
TG_PASSWORD=
# Savanna serves REST and GSQL over 443
TG_RESTPP_PORT=443
TG_GS_PORT=443
TG_TGCLOUD=true

# --- LLM ---
ANTHROPIC_API_KEY=
