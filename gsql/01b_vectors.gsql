// Vector attributes for GraphRAG (384-d, BAAI/bge-small-en-v1.5). HNSW index builds automatically.
CREATE GLOBAL SCHEMA_CHANGE JOB add_vectors {
  ALTER VERTEX ClosedCase ADD VECTOR ATTRIBUTE emb(DIMENSION=384, METRIC="COSINE");
  ALTER VERTEX FraudCase ADD VECTOR ATTRIBUTE emb(DIMENSION=384, METRIC="COSINE");
  ALTER VERTEX DocChunk ADD VECTOR ATTRIBUTE emb(DIMENSION=384, METRIC="COSINE");
}
RUN GLOBAL SCHEMA_CHANGE JOB add_vectors
